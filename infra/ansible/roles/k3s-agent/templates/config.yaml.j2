{# Jinja2 template: Ansible thay {{ biến }} rồi ghi ra /etc/rancher/k3s/config.yaml trên máy agent.
   Mục đích: mọi cờ của k3s agent nằm trong Git thay vì trên dòng lệnh cài đặt.
   Cách đọc: {{ x }} = chèn giá trị biến x; {% if %} = điều kiện. hostvars[<máy>].<biến> = đọc biến của
   máy KHÁC; groups['k3s_server'][0] = máy đầu tiên trong nhóm k3s_server (PC hoặc VM).
   Tham khảo: docs/huong-dan/w2.md §3.3–§3.4 #}
# Quản lý bởi Ansible (role k3s-agent). Sửa trong Git, không sửa tay trên máy.
# File chứa token join cluster nên chỉ root đọc được (mode 0600).

# Địa chỉ API server mà agent kết nối tới (node_ip của server: IP Tailscale ở nhà, cổng 6443)
server: https://{{ hostvars[groups['k3s_server'][0]].node_ip }}:6443
# Token do role k3s-server đọc từ /var/lib/rancher/k3s/server/node-token (cùng lần chạy playbook)
token: {{ hostvars[groups['k3s_server'][0]].k3s_token }}
# IP của chính máy agent; ghi rõ để k3s không chọn nhầm card mạng (xem template của server)
node-ip: {{ node_ip }}
{% if flannel_iface %}

# Card mạng mà flannel (mạng pod giữa các node, đóng gói VXLAN) dùng để gửi gói tin sang node khác.
# Phải trùng card chứa node-ip; ở nhà là tailscale0 vì IP LAN do router chung cư cấp và hay đổi.
flannel-iface: {{ flannel_iface }}
{% endif %}
{% if gpu_node %}

# Nhãn để device plugin và pod vLLM chọn được node này (giống server)
node-label:
  - nvidia.com/gpu.present=true
{% endif %}
