# ──────────────────────────────────────────────────────────────────────────────
# .env.example
# Khái niệm: Mẫu biến môi trường cục bộ. Chép thành `.env` (đã gitignore) rồi điền giá trị thật:
#            `cp .env.example .env`. Script đọc file này bằng `source .env`.
# Mục đích:  Nơi duy nhất chứa giá trị riêng từng người (template Vast, sau này khoá R2…), để script
#            không phải ghi cứng giá trị vào code và không lộ bí mật lên Git.
# Tham khảo: docs/huong-dan/w2.md §2.2, §11.2
# ──────────────────────────────────────────────────────────────────────────────

# Hash của template VM trên Vast.ai: Ubuntu có sẵn driver NVIDIA (driver ≥ 580 cho image vLLM v0.31.0, CUDA 13).
# Lấy ở console.vast.ai → Templates → lọc loại VM → mở template → chép "template hash".
# infra/provision/vast.sh dùng biến này khi thuê máy (`make rent`).
VAST_VM_TEMPLATE=

# Sao lưu lên Cloudflare R2 (experiments/runner/backup.py). rclone đọc cấu hình từ biến RCLONE_CONFIG_<TÊN>_*,
# nên không cần file rclone.conf. <TÊN> = R2 ứng với phần trước dấu `:` của R2_REMOTE.
# Lấy khoá ở dash.cloudflare.com → R2 → Manage API Tokens (quyền Object Read & Write, chỉ bucket này).
R2_REMOTE=r2:llm-thesis/runs
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=

# Báo tin của runner (experiments/runner/notify.py). Bot riêng, không dùng chung với Alertmanager.
# Tạo bot bằng @BotFather; lấy chat id bằng cách nhắn cho bot rồi mở /getUpdates của Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
