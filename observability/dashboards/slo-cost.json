{
  "uid": "llm-slo-cost",
  "title": "LLM / SLO và chi phí",
  "description": "Dashboard 3/3 (F5): người dùng có được phục vụ đúng SLO không (Thông số §6), ngân sách lỗi còn bao nhiêu, cảnh báo nào đã kêu, và đang tốn bao nhiêu GPU-giờ (Vận hành §9). Chọn khoảng thời gian bằng đúng một lượt đánh giá để đọc số của lượt đó.",
  "tags": [
    "llm-k8s-autoscaling"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "weekStart": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Pha kịch bản (runner)",
        "target": {
          "type": "tags",
          "tags": [
            "llm-run"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Cảnh báo LLM đang bật",
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", alertname=~\"LLM.+|Keda.+\"})",
        "step": "15s",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}}",
        "tagKeys": "severity",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Dashboard LLM",
      "type": "dashboards",
      "tags": [
        "llm-k8s-autoscaling"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Nguồn dữ liệu",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "gpu_price",
        "label": "Đơn giá GPU-giờ (USD)",
        "type": "textbox",
        "description": "Giá thuê một GPU trong một giờ của máy đang chạy. Mặc định 0,5 là giá trần khi chọn máy Vast (Thông số §10.2); ở nhà đặt 0.",
        "query": "0.5",
        "current": {
          "text": "0.5",
          "value": "0.5"
        },
        "options": [
          {
            "selected": true,
            "text": "0.5",
            "value": "0.5"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLI so với SLO (5 phút gần nhất)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "TTFT ≤ 2,5 s",
      "description": "Tỷ lệ request có thời gian tới token đầu ≤ 2,5 s trong 5 phút qua (1 − llm:ttft_bad_ratio:rate5m). SLO: ≥ 95%. Không có traffic thì trống.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - llm:ttft_bad_ratio:rate5m",
          "legendFormat": "TTFT tốt",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "–",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "TPOT ≤ 100 ms",
      "description": "Tỷ lệ request có thời gian trung bình mỗi token đầu ra ≤ 100 ms (vllm:request_time_per_output_token_seconds, mỗi request một mẫu). Bucket 0,1 có thật trong vLLM v0.31.0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(vllm:request_time_per_output_token_seconds_bucket{namespace=\"llm-serving\", le=\"0.1\"}[5m])) / sum(rate(vllm:request_time_per_output_token_seconds_count{namespace=\"llm-serving\"}[5m]))",
          "legendFormat": "TPOT tốt",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "–",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Không lỗi 5xx",
      "description": "Tỷ lệ request Traefik không trả 5xx trong 5 phút qua (1 − llm:error_ratio:rate5m). SLO: ≥ 99%. Kind không có Traefik nên trống.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
