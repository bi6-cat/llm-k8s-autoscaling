    {
      "type": "timeseries",
      "title": "Tỷ lệ request đạt từng SLI (cửa sổ 5 phút)",
      "description": "Đường gạch: mục tiêu 95% (Thông số §6). Sau một lần tăng tải, đường TTFT tụt trước; đường TPOT chỉ tụt khi batch quá lớn.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - llm:ttft_bad_ratio:rate5m",
