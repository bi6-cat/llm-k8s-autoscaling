    {
      "type": "timeseries",
      "title": "Burn rate TTFT",
      "description": "Burn rate = tỷ lệ request xấu ÷ ngân sách lỗi 5%. Bằng 1: tiêu ngân sách đúng tốc độ cho phép. Đường gạch 4: LLMSLOBurnFast kêu khi cả cửa sổ 5 phút và 1 phút cùng trên 4 trong 1 phút (Vận hành §3.3). Cửa sổ 30 phút dành cho cảnh báo phụ LLMSLOBurnSlow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "llm:ttft_bad_ratio:rate1m / 0.05",
          "legendFormat": "cửa sổ 1 phút",
          "range": true,
