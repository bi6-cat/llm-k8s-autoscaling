    {
      "type": "stat",
      "title": "Request đã trả xong (khoảng đang xem)",
      "description": "Số request vLLM trả xong trong khoảng thời gian đang xem, mọi lý do kết thúc. Lưu ý: request đạt SLO khi TTFT và TPOT đều đạt và không lỗi (Thông số §6). Histogram phía server không ghép được ba điều kiện cho từng request, và không thấy request timeout trong hàng đợi, nên SLO attainment chính thức tính từ requests.csv của máy tạo tải, không ở đây.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(vllm:request_success_total{namespace=\"llm-serving\"}[$__range]))",
          "legendFormat": "request xong",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
