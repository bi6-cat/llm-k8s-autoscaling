    {
      "type": "state-timeline",
      "title": "Cảnh báo LLM theo thời gian",
      "description": "Mỗi hàng một cảnh báo của nhóm (LLM…, Keda…). Cam: pending (điều kiện đúng nhưng chưa đủ thời gian `for`). Đỏ: firing, đã gửi tới Alertmanager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (alertname) (ALERTS{alertname=~\"LLM.+|Keda.+\", alertstate=\"firing\"}) * 2 or max by (alertname) (ALERTS{alertname=~\"LLM.+|Keda.+\", alertstate=\"pending\"})",
          "legendFormat": "{{alertname}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
