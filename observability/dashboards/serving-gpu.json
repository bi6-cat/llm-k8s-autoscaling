      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Huỷ hoặc lỗi (5 phút)",
      "description": "Request kết thúc với finished_reason abort (client ngắt, gồm timeout phía client) hoặc error (lỗi nội bộ, vLLM trả 500) trong 5 phút qua. Stream bị cắt giữa chừng vẫn có mã 200 nên không hiện ở tỷ lệ 5xx; nó hiện ở đây (Vận hành §2.1).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(vllm:request_success_total{namespace=\"llm-serving\", finished_reason=~\"abort|error\"}[5m]))",
          "legendFormat": "huỷ + lỗi",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "–",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
