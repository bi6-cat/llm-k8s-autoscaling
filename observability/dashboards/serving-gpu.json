        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Token sinh/s",
      "description": "Số token vLLM sinh ra mỗi giây, cả dịch vụ (llm:gen_tokens:rate1m). Dùng cho thông lượng và chi phí trên 1 triệu token.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "llm:gen_tokens:rate1m",
          "legendFormat": "token/s",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "decimals": 0
