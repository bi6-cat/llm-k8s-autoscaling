{
  "uid": "llm-serving-gpu",
  "title": "LLM / Serving và GPU",
  "description": "Dashboard 1/3 (F5): vLLM đang phục vụ thế nào và GPU đang làm gì. Dùng ở bước chẩn đoán của runbook (Vận hành §4.2) và trong mọi lượt đánh giá. Metric vLLM v0.31.0; GPU qua nvidia_gpu_exporter.",
  "tags": [
    "llm-k8s-autoscaling"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 41,
  "version": 1,
  "weekStart": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Pha kịch bản (runner)",
        "target": {
          "type": "tags",
          "tags": [
            "llm-run"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Cảnh báo LLM đang bật",
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", alertname=~\"LLM.+|Keda.+\"})",
        "step": "15s",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}}",
        "tagKeys": "severity",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Dashboard LLM",
      "type": "dashboards",
      "tags": [
        "llm-k8s-autoscaling"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Nguồn dữ liệu",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Tổng quan",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Pod vLLM Ready",
      "description": "Số pod của Deployment vllm đã Ready (nhận request). Bằng 0 là mất dịch vụ: Traefik trả 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"llm-serving\", deployment=\"vllm\"}",
          "legendFormat": "Ready",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "–",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Request hoàn tất/s",
      "description": "Số request vLLM trả xong mỗi giây, cộng mọi pod và mọi lý do kết thúc (rate của counter vllm:request_success_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(vllm:request_success_total{namespace=\"llm-serving\"}[$__rate_interval]))",
          "legendFormat": "req/s",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Request đồng thời",
      "description": "Đang chạy trên GPU + đang chờ trong hàng đợi, cộng mọi pod (recording rule llm:concurrency:sum). Đây cũng là tín hiệu của cấu hình A2.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "llm:concurrency:sum",
          "legendFormat": "running + waiting",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "TTFT p95 (1 phút)",
      "description": "Thời gian tới token đầu, phân vị 95 trong 1 phút qua (llm:ttft_p95:1m). Đỏ khi vượt ngưỡng SLO 2,5 s (Thông số §6). Chỉ là ước lượng từ histogram; nghiệm thu dùng log client.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "llm:ttft_p95:1m",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
