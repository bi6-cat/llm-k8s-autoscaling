{
  "uid": "llm-autoscaling",
  "title": "LLM / Autoscaling",
  "description": "Dashboard 2/3 (F5): KEDA và HPA quyết định gì, vì sao, và pod mất bao lâu để phục vụ được. Dùng ở bước 1 của runbook LLMSLOBurnFast (Vận hành §4.2) và để xem từng lượt ĐG2.",
  "tags": [
    "llm-k8s-autoscaling"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 41,
  "version": 1,
  "weekStart": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Pha kịch bản (runner)",
        "target": {
          "type": "tags",
          "tags": [
            "llm-run"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Cảnh báo LLM đang bật",
        "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", alertname=~\"LLM.+|Keda.+\"})",
        "step": "15s",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}}",
        "tagKeys": "severity",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Dashboard LLM",
      "type": "dashboards",
      "tags": [
        "llm-k8s-autoscaling"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Nguồn dữ liệu",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "hpa",
        "label": "HPA",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "HPA do KEDA tạo cho ScaledObject, tên keda-hpa-<ScaledObject> (A2: keda-hpa-vllm-a2). Lượt S1, S4 không có HPA.",
        "definition": "label_values(kube_horizontalpodautoscaler_info{namespace=\"llm-serving\"}, horizontalpodautoscaler)",
        "query": {
          "qryType": 1,
          "query": "label_values(kube_horizontalpodautoscaler_info{namespace=\"llm-serving\"}, horizontalpodautoscaler)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Số replica",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Số replica: HPA muốn và thực tế",
      "description": "Chuỗi phản ứng khi tải tăng: tín hiệu vượt target → HPA tăng desired (chu kỳ sync 5 s, KEDA hỏi Prometheus mỗi 5 s) → Deployment tạo pod (spec) → pod Ready sau cold start. Khoảng cách giữa desired và Ready chính là cold start. Lượt S1, S4 không có HPA nên chỉ có spec và Ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "desired (HPA)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_spec_replicas{namespace=\"llm-serving\", deployment=\"vllm\"}",
          "legendFormat": "spec (Deployment)",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"llm-serving\", deployment=\"vllm\"}",
          "legendFormat": "Ready",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "max",
          "range": true,
          "instant": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "min",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(max|min)$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 25
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "desired (HPA)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "desired (HPA)"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spec (Deployment)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spec (Deployment)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    0,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Hiện tại",
      "description": "Số pod Ready, số replica HPA muốn, và giới hạn trên (maxReplicaCount = N, Thông số §9.3).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"llm-serving\", deployment=\"vllm\"}",
          "legendFormat": "Ready",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "desired",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "max",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Tín hiệu so với target",
      "collapsed": false,
      "panels": [],
      "id": 4,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Tín hiệu (tổng) so với target × số replica",
      "description": "Với metricType AverageValue, HPA lấy tổng tín hiệu chia cho số replica rồi so với target: desired = ⌈tổng ÷ target⌉. Tổng vượt đường target × replica (nét đứt) quá 10% thì HPA scale up. Hai đường đầu là giá trị HPA đang thấy (kube-state-metrics); running + waiting là tín hiệu A2 đọc thẳng từ Prometheus, để thấy độ trễ của chuỗi KEDA → HPA. Với A1 (GPU %) đường running + waiting không cùng đơn vị, bỏ qua.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_status_target_metric{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\", metric_target_type=\"average\"} * on (namespace, horizontalpodautoscaler) group_left kube_horizontalpodautoscaler_status_current_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "tín hiệu theo HPA ({{metric_name}})",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_spec_target_metric{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\", metric_target_type=\"average\"} * on (namespace, horizontalpodautoscaler) group_left kube_horizontalpodautoscaler_status_current_replicas{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\"}",
          "legendFormat": "target × replica",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "llm:concurrency:sum",
          "legendFormat": "running + waiting (Prometheus)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^target × replica$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^tín hiệu theo HPA"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "timeseries",
      "title": "Tỷ lệ tín hiệu ÷ target",
      "description": "Giá trị mỗi replica chia target = tỷ lệ HPA dùng để tính desired (= ⌈replica × tỷ lệ⌉). Trong dải 0,9–1,1 (hai đường gạch, tolerance 10%, Thông số §9.3) HPA giữ nguyên. Trên 1,1: scale up ngay. Dưới 0,9: scale down sau cửa sổ ổn định 300 s, mỗi phút bớt 1 pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_horizontalpodautoscaler_status_target_metric{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\", metric_target_type=\"average\"} / on (namespace, horizontalpodautoscaler, metric_name, metric_target_type) kube_horizontalpodautoscaler_spec_target_metric{namespace=\"llm-serving\", horizontalpodautoscaler=~\"$hpa\", metric_target_type=\"average\"}",
          "legendFormat": "{{horizontalpodautoscaler}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 0.9
              },
              {
                "color": "orange",
                "value": 1.1
              }
            ]
          },
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      }
    },
    {
      "type": "row",
      "title": "Pod vLLM theo trạng thái",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "Pod theo trạng thái",
      "description": "Mỗi pod vLLM nằm ở đúng một trạng thái. Pending, chưa có node: scheduler chưa tìm được node, thường do hết GPU (LLMPodPending). Đã có node, tạo container: đang kéo image, gắn volume. Running, chưa Ready: vLLM đang nạp model và compile (phần dài nhất của cold start), hoặc container đang khởi động lại. Đang tắt: pod đã bị xoá, đang drain (preStop + --shutdown-timeout); pod vẫn giữ GPU tới khi tắt hẳn.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((kube_pod_status_phase{namespace=\"llm-serving\", pod=~\"vllm-.*\", phase=\"Pending\"} == 1) unless on (namespace, pod) (kube_pod_status_scheduled{namespace=\"llm-serving\", pod=~\"vllm-.*\", condition=\"true\"} == 1) unless on (namespace, pod) kube_pod_deletion_timestamp{namespace=\"llm-serving\", pod=~\"vllm-.*\"}) or vector(0)",
          "legendFormat": "Pending, chưa có node",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((kube_pod_status_phase{namespace=\"llm-serving\", pod=~\"vllm-.*\", phase=\"Pending\"} == 1) and on (namespace, pod) (kube_pod_status_scheduled{namespace=\"llm-serving\", pod=~\"vllm-.*\", condition=\"true\"} == 1) unless on (namespace, pod) kube_pod_deletion_timestamp{namespace=\"llm-serving\", pod=~\"vllm-.*\"}) or vector(0)",
          "legendFormat": "Đã có node, tạo container",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((kube_pod_status_phase{namespace=\"llm-serving\", pod=~\"vllm-.*\", phase=\"Running\"} == 1) and on (namespace, pod) (kube_pod_status_ready{namespace=\"llm-serving\", pod=~\"vllm-.*\", condition=\"false\"} == 1) unless on (namespace, pod) kube_pod_deletion_timestamp{namespace=\"llm-serving\", pod=~\"vllm-.*\"}) or vector(0)",
          "legendFormat": "Running, chưa Ready",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((kube_pod_status_ready{namespace=\"llm-serving\", pod=~\"vllm-.*\", condition=\"true\"} == 1) unless on (namespace, pod) kube_pod_deletion_timestamp{namespace=\"llm-serving\", pod=~\"vllm-.*\"}) or vector(0)",
          "legendFormat": "Ready",
          "range": true,
          "instant": false
        },
        {
          "refId": "E",
